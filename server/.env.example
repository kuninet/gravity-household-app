# サーバーポート番号
PORT=3001

# Gemini API キー（OCR機能で使用）
GEMINI_API_KEY=your_api_key_here

# TypeSafe AI API キー（Jevによる品名判定・価格推移分析で使用）
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ===== リモート MCP サーバー（/mcp） =====
# 認証方式。token（既定）: MCP_AUTH_TOKEN による Bearer 認証。none: 認証なし（トークン不要）。
# none は claude.ai のカスタムコネクタなどヘッダーを付けられないクライアント向け。
# 認証なしで家計簿の参照・更新ができてしまうため、外部公開時は必ず前段（Cloudflare Access / Tailscale 等）で接続元を制限してください。
MCP_AUTH_MODE=token

# Bearer 認証トークン（MCP_AUTH_MODE=token のとき必須）。未設定または16文字未満のとき /mcp は 503 を返し無効になります。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# true のときだけ ?token=<token> クエリでの認証を許可します（ログに残るため通常は false）。
MCP_ALLOW_QUERY_TOKEN=false

# 許可する Host ヘッダー（カンマ区切り）。外部公開時はトンネルのホスト名を指定します。
# 例: MCP_ALLOWED_HOSTS=localhost,gravity.example.com
MCP_ALLOWED_HOSTS=
